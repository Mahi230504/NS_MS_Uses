# --- Vision provider selection ---
# One of: gemini | vertex | openrouter
VISION_PROVIDER=gemini

# --- gemini provider (Google AI Studio, consumer API key) ---
GEMINI_API_KEY=
# Model name used by both gemini and vertex providers.
GEMINI_MODEL=gemini-2.0-flash

# --- vertex provider (Google Cloud, billed against your GCP project / credits) ---
# Path to a service-account JSON file. NEVER paste the JSON contents here.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
GCP_LOCATION=us-central1

# --- openrouter provider (OpenAI-compatible gateway, many models) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Admin user receives /issue_pair_code, /users, /revoke. Required for pairing.
TELEGRAM_ADMIN_ID=
# Deprecated. If set on a fresh install, IDs are migrated into users.json with
# policy "confirm_sensitive". Prefer pairing via /pair from now on.
TELEGRAM_ALLOWED_USER_IDS=

# --- Device ---
ANDROID_DEVICE_ID=emulator-5554
# Opt-in to drive a real Android phone instead of an emulator. Default
# (empty / unset) refuses to start if a physical device is attached. HITL
# gates still fire on payment / OTP / permission screens; review carefully.
ALLOW_PHYSICAL_DEVICE=
# Vision-augmented HITL doubles Gemini calls per state-changing action.
# Default OFF — keyword filter still gates payment/OTP/permission screens.
# Turn on (=1) only when running on paid Gemini tier.
ENABLE_VISION_HITL=

# --- External trigger webhook (Android voice / home-screen trigger) ---
# Start a task without opening Telegram: an on-device trigger (e.g. the free
# HTTP Shortcuts app) POSTs the spoken text to /trigger. The agent speaks back
# what it understood; you confirm yes/no; only then does it run. Status, HITL
# approval, and OTP/payment gates still fire on Telegram.
# For a USB phone the agent runs `adb reverse tcp:<port> tcp:<port>` on startup,
# so the phone POSTs to http://127.0.0.1:<port> over the cable — nothing is
# exposed on the network. Leave WEBHOOK_SECRET empty to disable the server.
# Generate a strong secret, e.g.:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# Which paired user a trigger acts as. Defaults to TELEGRAM_ADMIN_ID if unset.
WEBHOOK_OWNER_USER_ID=
# Bind address + port. Keep 127.0.0.1 with the adb-reverse (USB) setup above.
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8765

# --- Cross-app comparison (#6) ---
# How many candidate apps a single comparison probes (each probe is a full
# agent run on the one device, so this bounds latency). Min 2.
COMPARISON_MAX_CANDIDATES=3

# --- Scheduled / recurring tasks (#5) ---
# IANA timezone your schedules are expressed in. "every day at 9am" is read in
# this zone and stored as absolute UTC.
TIMEZONE=Asia/Kolkata

# --- Personal-assistant dashboard (#6 visualization) ---
# A live web view of your runs (screenshot + tapped-path replay), history,
# preferred apps, saved tasks, schedules, and comparisons. Disabled when the
# token is empty (no port opened). Owner = WEBHOOK_OWNER_USER_ID / admin.
# Generate a token, e.g.: python -c "import secrets;print(secrets.token_urlsafe(24))"
DASHBOARD_TOKEN=
# Bind address + port (localhost; adb-reversed so the phone can load it over USB
# too). Open http://127.0.0.1:8770 in a browser once the SPA is built.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8770
# Allowed origin for the Vite dev server (only matters during `npm run dev`).
DASHBOARD_CORS_ORIGIN=http://localhost:5173
# Where the built SPA lives (served in-process in prod). Defaults to dashboard/dist.
DASHBOARD_DIST_DIR=

# --- Google cloud actions (Gmail send + Google Meet scheduling) ---
# Lets the agent send email and create Calendar events with Meet links straight
# from a voice/text command — no phone automation involved. Leave the client
# id/secret empty to disable; everything degrades to a "connect Google from
# Settings" hint. Setup (Google Cloud Console, console.cloud.google.com):
#   1. Create (or pick) a project, then enable the Gmail API and the Google
#      Calendar API under APIs & Services -> Library.
#   2. Configure the OAuth consent screen (External; add yourself as a test
#      user — that's enough for personal use).
#   3. APIs & Services -> Credentials -> Create Credentials -> OAuth client ID,
#      application type "Web application".
#   4. Add the authorized redirect URI (must match GOOGLE_REDIRECT_URI below):
#        http://127.0.0.1:8770/api/google/oauth/callback
#   5. Paste the client ID + secret here, restart the bot, then click
#      "Connect Google" on the dashboard Settings page. The connected account
#      is the default sender for every email/Meet action.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to http://127.0.0.1:<DASHBOARD_PORT>/api/google/oauth/callback.
# Override only if the dashboard is reached at a different host/port.
GOOGLE_REDIRECT_URI=

# --- Misc ---
SESSION_TIMEOUT_SECONDS=180
# Optional override. Defaults to ~/.mobile-agent/logs/.
LOG_DIR=
